# KOMPAGNON Backend — Umgebungsvariablen
#
# Für lokale Entwicklung: `bash scripts/dev.sh` erzeugt daraus automatisch
# eine .env mit lokalen Standardwerten. Diese Datei ist die Vorlage und wird
# committet — die .env selbst NIE.
#
# Produktiv/Staging werden die Werte im Render-Dashboard gesetzt.

# ── Pflicht ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://localhost:5432/kompagnon_local
SECRET_KEY=lokaler-entwicklungs-schluessel-bitte-ersetzen
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# ── Frontend / CORS ──────────────────────────────────────────────────────────
FRONTEND_URL=http://localhost:3000
CORS_ALLOWED_ORIGINS=http://localhost:3000
API_BASE_URL=http://localhost:8000

# ── Lokale Demo-Zugänge ──────────────────────────────────────────────────────
# Werden beim Backend-Start angelegt, wenn ENVIRONMENT development/local/staging ist.
# Die Adressen müssen verschieden und dürfen nicht leer sein — sonst scheitert das
# Anlegen an der Unique-Bedingung und es entsteht KEIN einziger Zugang.
ADMIN_EMAIL=admin@kompagnon.local
ADMIN_PASSWORD=lokal-nur-fuer-entwicklung
# Aus zwei Demo-Konten (auditor, nutzer) ist am 27.08.2026 eines geworden —
# wie aus den zwei Rollen (L-129). Die neuen Namen sind MITARBEITER_*.
MITARBEITER_EMAIL=mitarbeiter@kompagnon.local
MITARBEITER_PASSWORD=lokal-nur-fuer-entwicklung
# AUDITOR_* wird weiter als Rueckfall gelesen (main.py), damit eine Umgebung,
# die es gesetzt hat, nicht ploetzlich ein Zufallspasswort bekommt. Neu
# einrichten sollte man es nicht.
# NUTZER_EMAIL / NUTZER_PASSWORD standen hier bis zum 27.08. und werden seit
# der Zusammenlegung von **keiner Zeile mehr gelesen** — entfernt, damit
# niemand sie setzt und sich wundert.
KUNDE_EMAIL=kunde@kompagnon.local
KUNDE_PASSWORD=lokal-nur-fuer-entwicklung

# ── KI ───────────────────────────────────────────────────────────────────────
# Ohne Schlüssel laufen die Agenten in ihren Mock-Modus — für UI-Arbeit genug.
ANTHROPIC_API_KEY=

# ── KI-Sichtbarkeit für GEO (L-58 b, 22.08.2026) ─────────────────────────────
# Womit gemessen wird, ob eine KI den Betrieb auf eine Kundenfrage hin nennt.
# Jeder Schlüssel steht für ein System; wer keinen hat, wird nicht gefragt und
# erscheint im Bericht als „nicht erhoben" — nie als Null. Ein leeres Feld
# zählt dabei wie ein fehlendes.
#
#   OPENAI_API_KEY       ChatGPT      platform.openai.com  · Responses API
#   PERPLEXITY_API_KEY   Perplexity   perplexity.ai/settings/api
#   ANTHROPIC_API_KEY    Claude       (oben, wird mitbenutzt)
#
# Achtung Perplexity: Die alte Sonar-Chat-Completions-Schnittstelle wird am
# 27.09.2026 abgeschaltet. Angebunden ist die Agent API (/v1/agent).
OPENAI_API_KEY=
PERPLEXITY_API_KEY=

# ── E-Mail ───────────────────────────────────────────────────────────────────
# Lokal auf true lassen: verhindert echten Mailversand an echte Empfänger.
USE_MOCK_EMAIL=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_SENDER_NAME=
SMTP_SENDER_EMAIL=
FROM_EMAIL=

# ── Externe Dienste (lokal optional, leer = Funktion deaktiviert) ────────────
GOOGLE_PAGESPEED_API_KEY=
GOOGLE_PLACES_API_KEY=
NORTHDATA_API_KEY=
BREVO_API_KEY=
# Geheimnis in der Webhook-Adresse, mit der Brevo Zustellungsstörungen meldet.
# Brevo signiert seine Webhooks nicht — ohne diesen Wert bleibt der Endpunkt
# geschlossen. Einrichtung: docs/mail-zustellung.md
BREVO_WEBHOOK_SECRET=
NETLIFY_API_TOKEN=
NETLIFY_WEBHOOK_SECRET=

# ── Zahlungen — lokal leer lassen, sonst drohen echte Buchungen ──────────────
# Jede in Stripe eingetragene Webhook-Adresse hat ihr EIGENES
# Signaturgeheimnis. Drei Adressen, drei Werte — wer denselben Wert
# zweimal eintraegt, bekommt an einer der Adressen nie eine gueltige
# Signatur, und dort wird keine Zahlung je verbucht.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=       # /api/payments/webhook  (Websprints)
STRIPE_WEBHOOK_SECRET_BUCH=  # /api/book/webhook      (Buch + Shop)
STRIPE_WEBHOOK_SECRET_GEO=   # /api/geo-payments/webhook (GEO-Abo)

# ── Verschlüsselung gespeicherter Zugangsdaten ───────────────────────────────
CREDENTIALS_KEY=
CMS_ENCRYPTION_KEY=

# ── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOK_SECRET=
TRACKDESK_WEBHOOK_SECRET=

# ── Firmenangaben (Rechnungen/PDFs) ──────────────────────────────────────────
COMPANY_ADDRESS=
CONTACT_EMAIL=
CONTACT_PHONE=
BANK_NAME=
BANK_IBAN=
BANK_BIC=

# ── Sonstiges ────────────────────────────────────────────────────────────────
UPLOAD_ROOT=./uploads
HWK_SCRAPER_ENABLED=false
SCHEDULER_TIMEZONE=Europe/Berlin
